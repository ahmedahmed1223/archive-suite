!.vscode/settings.json

# JetBrains IDEs (PhpStorm/WebStorm). dataSources.xml can carry a real DB
# connection; this was untracked entirely, not filtered.
.idea/

# Git Bash crash dumps (Windows)
*.stackdump

docs/performance/runs/

# Live-acceptance evidence is generated on the target host and must stay out of
# source control (docs/acceptance/v1-extended-capabilities.md). The redacted
# summary that IS committed lives in docs/evidence/<task>/.
artifacts/

# stray error log
live-final.err
