# V1-X03 GPU Arabic transcription acceptance image -- TEST ONLY, NOT SHIPPED.
#
# The product invokes the `whisper-ctranslate2` binary (config media.whisper_binary)
# with model large-v3 on device cuda. The existing infra/Dockerfile.whisper does
# NOT provide that: it installs the openai-whisper package, preloads only the
# `base` model, and runs on a CPU-only python base as a Flask service. So the
# configured GPU path had no image at all -- this one exists to exercise it.
#
# cuDNN runtime is required: CTranslate2 4.x loads libcudnn at runtime and fails
# with a bare CUDA runtime image.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/models

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir whisper-ctranslate2==0.5.3

# Model weights are pulled at run time into /models so the image stays lean and
# the download is visible as part of the acceptance run rather than hidden in a
# build layer.
VOLUME ["/models"]

WORKDIR /work
