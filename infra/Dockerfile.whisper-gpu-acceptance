# V1-X03 GPU Arabic transcription acceptance image -- TEST ONLY, NOT SHIPPED.
#
# The product invokes the `whisper-ctranslate2` binary (config media.whisper_binary)
# with model large-v3 on device cuda. The shipped worker image (Dockerfile.worker)
# installs that CLI but has no CUDA/cuDNN runtime, so WHISPER_DEVICE=cuda would
# fail there -- this image exists to exercise the GPU path. (V2-202 removed a
# second, unrelated infra/Dockerfile.whisper that installed openai-whisper+base
# as a standalone CPU Flask service matching no actual deployment -- dead code,
# not this gap.)
#
# cuDNN runtime is required: CTranslate2 4.x loads libcudnn at runtime and fails
# with a bare CUDA runtime image.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/models

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir whisper-ctranslate2==0.5.3

# Model weights are pulled at run time into /models so the image stays lean and
# the download is visible as part of the acceptance run rather than hidden in a
# build layer.
VOLUME ["/models"]

WORKDIR /work
