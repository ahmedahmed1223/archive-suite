{
  "$schema": "./compatibility.v1.schema.json",
  "schemaVersion": "1.0",
  "title": "Archive Suite V1 platform compatibility contract",
  "supportPolicy": "Support is declared per entry. Windows Native and Linux Native are officially supported deployment targets; implementation defects are triaged and corrected in subsequent releases.",
  "runtimeProfiles": {
    "core": {
      "status": "supported",
      "description": "Canonical Laravel API, Next.js UI, PostgreSQL, Redis, worker, and Reverb."
    },
    "media": {
      "status": "supported",
      "description": "Media processing workloads; enable only after storage and capacity validation."
    },
    "edge": {
      "status": "supported",
      "description": "Public TLS ingress through Caddy; enable only for edge-facing deployments."
    }
  },
  "capabilities": {
    "ocr": {
      "status": "supported",
      "description": "OCR workloads are available through the media profile."
    },
    "ai": {
      "status": "supported",
      "description": "Optional AI workloads are configured through the organisation's provider settings."
    },
    "observability": {
      "status": "supported",
      "description": "Local structured logs, diagnostics, and health/readiness reporting."
    }
  },
  "ports": [
    {
      "id": "app",
      "port": 3000,
      "protocol": "tcp",
      "exposure": "public",
      "purpose": "Next.js application and proxied API health endpoint"
    },
    {
      "id": "caddy-http",
      "port": 80,
      "protocol": "tcp",
      "exposure": "public",
      "purpose": "HTTP ingress"
    },
    {
      "id": "caddy-https",
      "port": 443,
      "protocol": "tcp",
      "exposure": "public",
      "purpose": "HTTPS ingress when configured"
    },
    {
      "id": "reverb",
      "port": 8080,
      "protocol": "tcp",
      "exposure": "public",
      "purpose": "Realtime WebSocket endpoint"
    },
    {
      "id": "laravel",
      "port": 8000,
      "protocol": "tcp",
      "exposure": "internal",
      "purpose": "Laravel API service"
    },
    {
      "id": "postgres",
      "port": 5432,
      "protocol": "tcp",
      "exposure": "internal",
      "purpose": "PostgreSQL database"
    },
    {
      "id": "redis",
      "port": 6379,
      "protocol": "tcp",
      "exposure": "internal",
      "purpose": "Redis cache and queue"
    }
  ],
  "dataPaths": {
    "windows": {
      "root": "C:\\ArchiveSuite\\data",
      "postgres": "C:\\ArchiveSuite\\data\\postgres",
      "redis": "C:\\ArchiveSuite\\data\\redis",
      "storage": "C:\\ArchiveSuite\\data\\storage",
      "backups": "C:\\ArchiveSuite\\data\\backups"
    },
    "linux": {
      "root": "/var/lib/archive-suite",
      "postgres": "/var/lib/archive-suite/postgres",
      "redis": "/var/lib/archive-suite/redis",
      "storage": "/var/lib/archive-suite/storage",
      "backups": "/var/lib/archive-suite/backups"
    }
  },
  "resources": {
    "status": "provisional",
    "core": {
      "cpu": "4 vCPU",
      "memory": "8 GiB RAM",
      "disk": "100 GiB SSD",
      "diskBytes": 107374182400
    },
    "media": {
      "cpu": "8 vCPU",
      "memory": "16 GiB RAM",
      "disk": "250 GiB SSD",
      "diskBytes": 268435456000
    },
    "ocr": {
      "cpu": "8 vCPU",
      "memory": "16 GiB RAM",
      "disk": "250 GiB SSD",
      "diskBytes": 268435456000
    },
    "ai": {
      "cpu": "8 vCPU",
      "memory": "32 GiB RAM",
      "disk": "500 GiB SSD; accelerator sizing is provider-specific",
      "diskBytes": 536870912000
    },
    "observability": {
      "cpu": "4 vCPU",
      "memory": "8 GiB RAM",
      "disk": "150 GiB SSD including retained logs",
      "diskBytes": 161061273600
    }
  },
  "platforms": [
    {
      "id": "windows-10-11-docker",
      "label": "Windows 10/11 with Docker Desktop",
      "mode": "docker",
      "status": "supported",
      "requirements": {
        "node": ">=26.5.0 <27 on host; baseline 26.5.0",
        "docker": "Docker Desktop with Docker Compose v2",
        "php": "8.5.8 provided by the Laravel container",
        "composer": "2.10.2 provided by the Laravel container",
        "postgresql": "provided by the PostgreSQL container",
        "redis": "provided by the Redis container"
      },
      "profiles": ["core", "media", "edge"],
      "capabilities": ["ocr", "ai", "observability"],
      "dataPathFamily": "windows",
      "resourceStatus": "provisional"
    },
    {
      "id": "linux-docker",
      "label": "Linux with Docker Engine",
      "mode": "docker",
      "status": "supported",
      "requirements": {
        "node": ">=26.5.0 <27 on host; baseline 26.5.0",
        "docker": "Docker Engine with Docker Compose v2",
        "php": "8.5.8 provided by the Laravel container",
        "composer": "2.10.2 provided by the Laravel container",
        "postgresql": "provided by the PostgreSQL container",
        "redis": "provided by the Redis container"
      },
      "profiles": ["core", "media", "edge"],
      "capabilities": ["ocr", "ai", "observability"],
      "dataPathFamily": "linux",
      "resourceStatus": "provisional"
    },
    {
      "id": "windows-native",
      "label": "Windows Native",
      "mode": "native",
      "status": "supported",
      "evidence": "docs/evidence/v1.1.0-native/README.md",
      "requirements": {
        "node": ">=26.5.0 <27",
        "docker": "not required on the target host",
        "php": "8.5.8 (bundled, NTS, portable); pcntl is unavailable on Windows and guarded by Laravel",
        "composer": "used only to build the bundle (composer install --no-dev); not required on the target host",
        "postgresql": "managed PostgreSQL with pgvector and pgAdmin, or an operator-managed external endpoint",
        "redis": "optional; disabled by default, or operator-managed external endpoint"
      },
      "profiles": ["core", "media", "edge"],
      "capabilities": ["ocr", "ai", "observability"],
      "dataPathFamily": "windows",
      "resourceStatus": "supported"
    },
    {
      "id": "linux-native",
      "label": "Linux Native",
      "mode": "native",
      "status": "supported",
      "evidence": "docs/evidence/v1.1.0-native/README.md",
      "requirements": {
        "node": ">=26.5.0 <27",
        "docker": "not required on the target host",
        "php": "8.5.8 (bundled, static-php-cli, portable); pcntl is available and required on Linux",
        "composer": "used only to build the bundle (composer install --no-dev); not required on the target host",
        "systemd": "required (service management)",
        "postgresql": "managed PostgreSQL with pgvector and pgAdmin, or an operator-managed external endpoint",
        "redis": "optional; disabled by default, or operator-managed external endpoint"
      },
      "profiles": ["core", "media", "edge"],
      "capabilities": ["ocr", "ai", "observability"],
      "dataPathFamily": "linux",
      "resourceStatus": "supported"
    }
  ]
}
