{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archive-suite/setup-config.v1",
  "title": "Archive Suite V1 declarative setup configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "platform", "source", "intent", "access", "runtimeProfiles", "capabilities", "dataServices", "storage"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "mode": { "enum": ["docker", "native"] },
    "platform": { "type": "string", "minLength": 1 },
    "source": { "enum": ["online", "offline"] },
    "intent": { "enum": ["fresh", "repair", "reconfigure", "update", "rollback", "uninstall", "reconnect-data"] },
    "access": { "enum": ["local", "intranet", "public"] },
    "runtimeProfiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "dataServices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["postgres", "redis"],
      "properties": {
        "postgres": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["enabled"], "properties": { "enabled": { "type": "boolean" } } },
            { "type": "object", "additionalProperties": false, "required": ["enabled", "kind"], "properties": { "enabled": { "const": true }, "kind": { "const": "managed" } } },
            { "type": "object", "additionalProperties": false, "required": ["enabled", "kind", "host", "port", "database"], "properties": { "enabled": { "const": true }, "kind": { "const": "external" }, "host": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*[A-Za-z0-9]$" }, "port": { "type": "integer", "minimum": 1, "maximum": 65535 }, "database": { "type": "string", "minLength": 1 } } }
          ]
        },
        "redis": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["enabled"], "properties": { "enabled": { "type": "boolean" } } },
            { "type": "object", "additionalProperties": false, "required": ["enabled", "kind"], "properties": { "enabled": { "const": true }, "kind": { "const": "managed" } } },
            { "type": "object", "additionalProperties": false, "required": ["enabled", "kind", "host", "port"], "properties": { "enabled": { "const": true }, "kind": { "const": "external" }, "host": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*[A-Za-z0-9]$" }, "port": { "type": "integer", "minimum": 1, "maximum": 65535 } } }
          ]
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver", "path"],
      "properties": {
        "driver": { "const": "local" },
        "path": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*://)(?!.*[^/\\\\s:@]+:[^/\\\\s@]+@).+$" }
      }
    }
  }
}
